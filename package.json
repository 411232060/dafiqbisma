import { useState } from "react";
import { Plus, Search, Pencil, Trash2, Calendar } from "lucide-react";
import { useAppData } from "../hooks/useAppData";
import { Badge, statusDokterVariant } from "../components/ui/Badge";
import { Modal, ConfirmDialog } from "../components/ui/Modal";
import { generateId } from "../utils/format";
import type { JadwalDokter } from "../types";
import { toast } from "sonner";

const HARI = ["Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu", "Minggu"];
const emptyForm = { dokterId: "", poliklinikId: "", hari: "Senin", jamMulai: "08:00", jamSelesai: "12:00", kuotaPasien: 20, status: "Aktif" as const };

export default function JadwalDokterPage() {
  const { data, updateData } = useAppData();
  const [search, setSearch] = useState("");
  const [filterDokter, setFilterDokter] = useState("");
  const [filterPoli, setFilterPoli] = useState("");
  const [filterHari, setFilterHari] = useState("");
  const [modalAdd, setModalAdd] = useState(false);
  const [modalEdit, setModalEdit] = useState<JadwalDokter | null>(null);
  const [modalDelete, setModalDelete] = useState<string | null>(null);
  const [form, setForm] = useState(emptyForm);

  const filtered = data.jadwalDokter.filter((j) => {
    const dok = data.dokter.find((d) => d.id === j.dokterId);
    const matchSearch = !search || dok?.namaLengkap.toLowerCase().includes(search.toLowerCase());
    const matchDok = !filterDokter || j.dokterId === filterDokter;
    const matchPoli = !filterPoli || j.poliklinikId === filterPoli;
    const matchHari = !filterHari || j.hari === filterHari;
    return matchSearch && matchDok && matchPoli && matchHari;
  });

  const validate = () => {
    if (!form.dokterId || !form.poliklinikId) { toast.error("Pilih dokter dan poliklinik."); return false; }
    if (form.jamSelesai <= form.jamMulai) { toast.error("Jam selesai harus lebih dari jam mulai."); return false; }
    return true;
  };

  const handleAdd = () => {
    if (!validate()) return;
    const newJadwal: JadwalDokter = { ...form, id: generateId(), createdAt: new Date().toISOString().split("T")[0] };
    updateData({ jadwalDokter: [...data.jadwalDokter, newJadwal] });
    toast.success("Jadwal dokter berhasil ditambahkan.");
    setModalAdd(false); setForm(emptyForm);
  };

  const handleEdit = () => {
    if (!modalEdit || !validate()) return;
    updateData({ jadwalDokter: data.jadwalDokter.map((j) => j.id === modalEdit.id ? { ...modalEdit, ...form } : j) });
    toast.success("Jadwal berhasil diperbarui.");
    setModalEdit(null);
  };

  const handleDelete = (id: string) => {
    updateData({ jadwalDokter: data.jadwalDokter.filter((j) => j.id !== id) });
    toast.success("Jadwal berhasil dihapus.");
  };

  const openEdit = (j: JadwalDokter) => {
    setForm({ dokterId: j.dokterId, poliklinikId: j.poliklinikId, hari: j.hari, jamMulai: j.jamMulai, jamSelesai: j.jamSelesai, kuotaPasien: j.kuotaPasien, status: j.status });
    setModalEdit(j);
  };

  const JadwalForm = () => (
    <div className="space-y-4">
      <div className="grid grid-cols-2 gap-4">
        <div className="col-span-2">
          <label className="block text-sm font-semibold text-gray-700 mb-1">Dokter <span className="text-red-500">*</span></label>
          <select value={form.dokterId} onChange={(e) => setForm({ ...form, dokterId: e.target.value })} className="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
            <option value="">-- Pilih Dokter --</option>
            {data.dokter.filter((d) => d.status === "Aktif").map((d) => <option key={d.id} value={d.id}>{d.namaLengkap}</option>)}
          </select>
        </div>
        <div className="col-span-2">
          <label className="block text-sm font-semibold text-gray-700 mb-1">Poliklinik <span className="text-red-500">*</span></label>
          <select value={form.poliklinikId} onChange={(e) => setForm({ ...form, poliklinikId: e.target.value })} className="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
            <option value="">-- Pilih Poliklinik --</option>
            {data.poliklinik.map((p) => <option key={p.id} value={p.id}>{p.namaPoliklinik}</option>)}
          </select>
        </div>
        <div>
          <label className="block text-sm font-semibold text-gray-700 mb-1">Hari Praktik</label>
          <select value={form.hari} onChange={(e) => setForm({ ...form, hari: e.target.value })} className="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
            {HARI.map((h) => <option key={h}>{h}</option>)}
          </select>
        </div>
        <div>
          <label className="block text-sm font-semibold text-gray-700 mb-1">Kuota Pasien</label>
          <input type="number" value={form.kuotaPasien} onChange={(e) => setForm({ ...form, kuotaPasien: Number(e.target.value) })} className="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" min={1} />
        </div>
        <div>
          <label className="block text-sm font-semibold text-gray-700 mb-1">Jam Mulai</label>
          <input type="time" value={form.jamMulai} onChange={(e) => setForm({ ...form, jamMulai: e.target.value })} className="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
        </div>
        <div>
          <label className="block text-sm font-semibold text-gray-700 mb-1">Jam Selesai</label>
          <input type="time" value={form.jamSelesai} onChange={(e) => setForm({ ...form, jamSelesai: e.target.value })} className="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
        </div>
        <div>
          <label className="block text-sm font-semibold text-gray-700 mb-1">Status</label>
          <select value={form.status} onChange={(e) => setForm({ ...form, status: e.target.value as "Aktif" | "Tidak Aktif" })} className="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
            <option>Aktif</option><option>Tidak Aktif</option>
          </select>
        </div>
      </div>
      <div className="flex gap-3 pt-2 justify-end">
        <button onClick={() => { setModalAdd(false); setModalEdit(null); }} className="px-5 py-2.5 rounded-xl border border-gray-200 text-sm font-medium hover:bg-gray-50">Batal</button>
        <button onClick={modalEdit ? handleEdit : handleAdd} className="px-5 py-2.5 rounded-xl bg-blue-600 text-white text-sm font-medium hover:bg-blue-700">
          {modalEdit ? "Simpan" : "Tambah Jadwal"}
        </button>
      </div>
    </div>
  );

  return (
    <div className="space-y-5">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl font-bold text-gray-900">Jadwal Dokter</h1>
          <p className="text-gray-500 text-sm mt-0.5">{data.jadwalDokter.length} jadwal terdaftar</p>
        </div>
        <button onClick={() => { setForm(emptyForm); setModalAdd(true); }} className="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold px-4 py-2.5 rounded-xl transition-colors">
          <Plus size={16} />Tambah Jadwal
        </button>
      </div>

      <div className="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
        <div className="px-4 py-3 border-b border-gray-50 flex flex-wrap gap-3">
          <div className="flex items-center gap-2 bg-gray-50 border border-gray-200 rounded-xl px-3 py-2 flex-1 min-w-[160px]">
            <Search size={14} className="text-gray-400" />
            <input value={search} onChange={(e) => setSearch(e.target.value)} placeholder="Cari dokter..." className="bg-transparent text-sm outline-none w-full" />
          </div>
          <select value={filterDokter} onChange={(e) => setFilterDokter(e.target.value)} className="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-400">
            <option value="">Semua Dokter</option>
            {data.dokter.map((d) => <option key={d.id} value={d.id}>{d.namaLengkap}</option>)}
          </select>
          <select value={filterPoli} onChange={(e) => setFilterPoli(e.target.value)} className="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-400">
            <option value="">Semua Poliklinik</option>
            {data.poliklinik.map((p) => <option key={p.id} value={p.id}>{p.namaPoliklinik}</option>)}
          </select>
          <select value={filterHari} onChange={(e) => setFilterHari(e.target.value)} className="border border-gray-200 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-blue-400">
            <option value="">Semua Hari</option>
            {HARI.map((h) => <option key={h}>{h}</option>)}
          </select>
        </div>

        {filtered.length === 0 ? (
          <div className="py-16 text-center text-gray-400">
            <Calendar size={40} className="mx-auto mb-3 opacity-30" />
            <p>Tidak ada jadwal ditemukan</p>
          </div>
        ) : (
          <div className="overflow-x-auto">
            <table className="w-full text-sm">
              <thead>
                <tr className="bg-gray-50/50">
                  {["Dokter", "Poliklinik", "Hari", "Jam", "Kuota", "Status", "Aksi"].map((h) => (
                    <th key={h} className="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase tracking-wide whitespace-nowrap">{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody className="divide-y divide-gray-50">
                {filtered.map((j) => {
                  const dok = data.dokter.find((d) => d.id === j.dokterId);
                  const poli = data.poliklinik.find((p) => p.id === j.poliklinikId);
                  return (
                    <tr key={j.id} className="hover:bg-gray-50/50 transition-colors">
                      <td className="px-4 py-3 font-medium text-gray-900 whitespace-nowrap">{dok?.namaLengkap || "-"}</td>
                      <td className="px-4 py-3 text-gray-600">{poli?.namaPoliklinik || "-"}</td>
                      <td className="px-4 py-3 text-gray-700 font-medium">{j.hari}</td>
                      <td className="px-4 py-3 text-gray-600 font-mono text-xs whitespace-nowrap">{j.jamMulai} – {j.jamSelesai}</td>
                      <td className="px-4 py-3 text-gray-600">{j.kuotaPasien} pasien</td>
                      <td className="px-4 py-3"><Badge variant={statusDokterVariant(j.status)}>{j.status}</Badge></td>
                      <td className="px-4 py-3">
                        <div className="flex items-center gap-1">
                          <button onClick={() => openEdit(j)} className="p-1.5 rounded-lg hover:bg-amber-50 text-amber-600"><Pencil size={14} /></button>
                          <button onClick={() => setModalDelete(j.id)} className="p-1.5 rounded-lg hover:bg-red-50 text-red-600"><Trash2 size={14} /></button>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>

      <Modal open={modalAdd} onClose={() => setModalAdd(false)} title="Tambah Jadwal Dokter" size="md"><JadwalForm /></Modal>
      <Modal open={!!modalEdit} onClose={() => setModalEdit(null)} title="Edit Jadwal Dokter" size="md"><JadwalForm /></Modal>
      <ConfirmDialog open={!!modalDelete} onClose={() => setModalDelete(null)} onConfirm={() => { handleDelete(modalDelete!); setModalDelete(null); }} title="Hapus Jadwal" message="Apakah Anda yakin ingin menghapus jadwal dokter ini?" />
    </div>
  );
}
